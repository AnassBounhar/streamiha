Options -Indexes
ServerSignature Off
ErrorDocument 404 /pages/oopsy.html

<FilesMatch "(^\.|\.env|composer\.(json|lock)|package(-lock)?\.json|yarn\.lock|pnpm-lock\.yaml)$">
Require all denied
</FilesMatch>

<IfModule mod_rewrite.c>
RewriteEngine On
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP_HOST} !^localhost(:[0-9]+)?$ [NC]
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]
RewriteRule ^analytics/?$ /pages/analytics.html [L,NC]
RewriteRule ^player\.php$ /pages/player.php [L,NC]
RewriteCond %{REQUEST_URI} ^/$
RewriteRule ^$ /pages/index.html [L]
RewriteRule ^index\.html$ /pages/index.html [L]
RewriteRule ^(content|details|analytics)\.html$ /pages/$1.html [L,NC]
</IfModule>

<IfModule mod_headers.c>
Header always set X-Content-Type-Options "nosniff"
Header always set X-Frame-Options "SAMEORIGIN"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
SetEnvIfExpr "%{HTTPS} == 'on'" is_https
SetEnvIfNoCase Host "^localhost(:[0-9]+)?$" is_localhost
Header always set Cross-Origin-Opener-Policy "same-origin" env=is_https
Header always set Cross-Origin-Opener-Policy "same-origin" env=is_localhost
Header always set Cross-Origin-Resource-Policy "same-origin"
Header always set Content-Security-Policy "default-src 'self'; connect-src 'self' https://api.themoviedb.org https://image.tmdb.org https://www.youtube.com https://www.youtube-nocookie.com https://s.ytimg.com https://i.ytimg.com; img-src 'self' data: blob: https://image.tmdb.org https://i.ytimg.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; script-src 'self' https://www.youtube.com https://s.ytimg.com; frame-src https://www.youtube.com https://www.youtube-nocookie.com https://www.vidking.net https://vidking.net https://www.vidsrc.icu https://vidsrc.icu https://player.autoembed.cc https://www.autoembed.cc https://autoembed.cc; media-src 'self' https:; font-src 'self' data: https://fonts.gstatic.com; object-src 'none'; base-uri 'self'; frame-ancestors 'self'; form-action 'self'"
</IfModule>
